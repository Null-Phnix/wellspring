{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Wellspring public demo: private source buckets, scoped read-only API, static frontend and daily ST1 intake.",
  "Parameters": {
    "CodeKey": {
      "Type": "String",
      "Default": ""
    },
    "ScheduleState": {
      "Type": "String",
      "Default": "DISABLED",
      "AllowedValues": [
        "ENABLED",
        "DISABLED"
      ]
    },
    "AskEnabled": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "true",
        "false"
      ]
    },
    "AskProviderUrl": {
      "Type": "String",
      "Default": "https://api.deepseek.com",
      "AllowedValues": [
        "https://api.deepseek.com"
      ]
    },
    "AskModel": {
      "Type": "String",
      "Default": "deepseek-chat",
      "AllowedValues": [
        "deepseek-chat"
      ]
    },
    "AskKeyParameter": {
      "Type": "String",
      "Default": "/wellspring/ask/provider_key",
      "AllowedValues": [
        "/wellspring/ask/provider_key"
      ]
    },
    "AskDailyLimit": {
      "Type": "Number",
      "Default": 100,
      "MinValue": 1,
      "MaxValue": 1000
    }
  },
  "Conditions": {
    "HasCode": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "CodeKey"
            },
            ""
          ]
        }
      ]
    },
    "AskEnabledCondition": {
      "Fn::Equals": [
        {
          "Ref": "AskEnabled"
        },
        "true"
      ]
    }
  },
  "Resources": {
    "DataBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        }
      }
    },
    "SiteBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        }
      }
    },
    "OriginAccess": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-site"
          },
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "DefaultRootObject": "index.html",
          "PriceClass": "PriceClass_100",
          "Origins": [
            {
              "Id": "site",
              "DomainName": {
                "Fn::GetAtt": [
                  "SiteBucket",
                  "RegionalDomainName"
                ]
              },
              "OriginAccessControlId": {
                "Ref": "OriginAccess"
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "site",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD",
              "OPTIONS"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": true,
            "ForwardedValues": {
              "QueryString": false,
              "Cookies": {
                "Forward": "none"
              }
            },
            "DefaultTTL": 300,
            "MaxTTL": 3600,
            "MinTTL": 0
          },
          "CustomErrorResponses": [
            {
              "ErrorCode": 403,
              "ResponseCode": 200,
              "ResponsePagePath": "/index.html",
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 404,
              "ResponseCode": 200,
              "ResponsePagePath": "/index.html",
              "ErrorCachingMinTTL": 0
            }
          ],
          "ViewerCertificate": {
            "CloudFrontDefaultCertificate": true
          }
        }
      }
    },
    "SitePolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "SiteBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${SiteBucket.Arn}/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "ApiRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "project-data-and-logs",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "${DataBucket.Arn}/published/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${AWS::StackName}-api:*"
                  }
                }
              ]
            }
          },
          {
            "PolicyName": "ask-secret-and-quota",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ssm:GetParameter"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter${AskKeyParameter}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:UpdateItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "AskQuotaTable",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "ASK#*"
                      ]
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "ApiLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-api"
        },
        "RetentionInDays": 7
      }
    },
    "ApiFunction": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": "ApiLogs",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-api"
        },
        "Runtime": "python3.13",
        "Architectures": [
          "arm64"
        ],
        "Role": {
          "Fn::GetAtt": [
            "ApiRole",
            "Arn"
          ]
        },
        "MemorySize": 512,
        "Timeout": 15,
        "Handler": {
          "Fn::If": [
            "HasCode",
            "wellspring.api.handler.lambda_handler",
            "index.handler"
          ]
        },
        "Code": {
          "Fn::If": [
            "HasCode",
            {
              "S3Bucket": {
                "Ref": "DataBucket"
              },
              "S3Key": {
                "Ref": "CodeKey"
              }
            },
            {
              "ZipFile": "def handler(event, context):\n    return {\"statusCode\":503,\"body\":\"Dataset is being prepared\"}\n"
            }
          ]
        },
        "Environment": {
          "Variables": {
            "DATA_BUCKET": {
              "Ref": "DataBucket"
            },
            "MANIFEST_KEY": "published/manifest.json",
            "ALLOWED_ORIGINS": {
              "Fn::Sub": "https://${Distribution.DomainName},http://localhost:4200"
            },
            "ASK_KEY_PARAMETER": {
              "Fn::If": [
                "AskEnabledCondition",
                {
                  "Ref": "AskKeyParameter"
                },
                ""
              ]
            },
            "ASK_QUOTA_TABLE": {
              "Ref": "AskQuotaTable"
            },
            "ASK_PROVIDER_URL": {
              "Ref": "AskProviderUrl"
            },
            "ASK_MODEL": {
              "Ref": "AskModel"
            },
            "ASK_DAILY_LIMIT": {
              "Fn::Sub": "${AskDailyLimit}"
            }
          }
        }
      }
    },
    "IngestRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "project-data-and-logs",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "${DataBucket.Arn}/published/*"
                    },
                    {
                      "Fn::Sub": "${DataBucket.Arn}/raw/*"
                    },
                    {
                      "Fn::Sub": "${DataBucket.Arn}/history/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${AWS::StackName}-ingest:*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "IngestLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-ingest"
        },
        "RetentionInDays": 7
      }
    },
    "IngestFunction": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": "IngestLogs",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-ingest"
        },
        "Runtime": "python3.13",
        "Architectures": [
          "arm64"
        ],
        "Role": {
          "Fn::GetAtt": [
            "IngestRole",
            "Arn"
          ]
        },
        "MemorySize": 512,
        "Timeout": 180,
        "Handler": {
          "Fn::If": [
            "HasCode",
            "wellspring.ingest.cloud.lambda_handler",
            "index.handler"
          ]
        },
        "Code": {
          "Fn::If": [
            "HasCode",
            {
              "S3Bucket": {
                "Ref": "DataBucket"
              },
              "S3Key": {
                "Ref": "CodeKey"
              }
            },
            {
              "ZipFile": "def handler(event, context):\n    return {\"statusCode\":503,\"body\":\"Dataset is being prepared\"}\n"
            }
          ]
        },
        "Environment": {
          "Variables": {
            "DATA_BUCKET": {
              "Ref": "DataBucket"
            },
            "MANIFEST_KEY": "published/manifest.json",
            "ALLOWED_ORIGINS": {
              "Fn::Sub": "https://${Distribution.DomainName},http://localhost:4200"
            }
          }
        }
      }
    },
    "HttpApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-api"
        },
        "ProtocolType": "HTTP"
      }
    },
    "ApiIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::GetAtt": [
            "ApiFunction",
            "Arn"
          ]
        },
        "PayloadFormatVersion": "2.0",
        "TimeoutInMillis": 16000
      }
    },
    "ApiRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "$default",
        "Target": {
          "Fn::Join": [
            "",
            [
              "integrations/",
              {
                "Ref": "ApiIntegration"
              }
            ]
          ]
        }
      }
    },
    "ApiStage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "StageName": "$default",
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "ThrottlingBurstLimit": 5,
          "ThrottlingRateLimit": 2
        }
      }
    },
    "ApiInvoke": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "ApiFunction"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${HttpApi}/*"
        }
      }
    },
    "ScheduleRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "scheduler.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "invoke-ingestion",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "lambda:InvokeFunction",
                  "Resource": {
                    "Fn::GetAtt": [
                      "IngestFunction",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "DailySchedule": {
      "Type": "AWS::Scheduler::Schedule",
      "Properties": {
        "Description": "Public AER ST1 intake at 07:00 Mountain including daylight saving time",
        "State": {
          "Ref": "ScheduleState"
        },
        "ScheduleExpression": "cron(0 7 * * ? *)",
        "ScheduleExpressionTimezone": "America/Edmonton",
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "Target": {
          "Arn": {
            "Fn::GetAtt": [
              "IngestFunction",
              "Arn"
            ]
          },
          "RoleArn": {
            "Fn::GetAtt": [
              "ScheduleRole",
              "Arn"
            ]
          },
          "Input": "{}",
          "RetryPolicy": {
            "MaximumRetryAttempts": 1,
            "MaximumEventAgeInSeconds": 3600
          }
        }
      }
    },
    "AskQuotaTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "quota_key",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "quota_key",
            "KeyType": "HASH"
          }
        ],
        "TimeToLiveSpecification": {
          "AttributeName": "expires_at",
          "Enabled": true
        },
        "SSESpecification": {
          "SSEEnabled": true
        }
      }
    }
  },
  "Outputs": {
    "DataBucket": {
      "Value": {
        "Ref": "DataBucket"
      }
    },
    "SiteBucket": {
      "Value": {
        "Ref": "SiteBucket"
      }
    },
    "ApiUrl": {
      "Value": {
        "Fn::GetAtt": [
          "HttpApi",
          "ApiEndpoint"
        ]
      }
    },
    "CloudFrontDomain": {
      "Value": {
        "Fn::GetAtt": [
          "Distribution",
          "DomainName"
        ]
      }
    },
    "ApiFunction": {
      "Value": {
        "Ref": "ApiFunction"
      }
    },
    "IngestFunction": {
      "Value": {
        "Ref": "IngestFunction"
      }
    },
    "AskQuotaTable": {
      "Value": {
        "Ref": "AskQuotaTable"
      }
    },
    "AskEnabled": {
      "Value": {
        "Ref": "AskEnabled"
      }
    },
    "AskModel": {
      "Value": {
        "Ref": "AskModel"
      }
    }
  }
}
